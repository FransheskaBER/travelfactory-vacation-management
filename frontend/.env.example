# Same-origin path prefix handled by the Vite dev proxy (vite.config.ts).
# Production must serve frontend and API from one origin (or configure real
# CORS + credentials at the gateway) — see known-limitations.
VITE_API_BASE_URL=/api
# Backend origin the dev proxy forwards to (CEF dev server).
VITE_API_PROXY_TARGET=http://localhost:8888
