LAMBDA_NAME=my-lambda
ALIAS=dev
dev_DATABASE_URL=postgresql://vacation:vacation@localhost:5432/vacation_db
dev_JWT_SECRET=change-me-local-dev-secret
# CORS allow-origin for actual responses (CEF Response class); unset falls back
# to "*". The dev server's preflight always answers "*" regardless (spec 4.8 §8 Q6).
# Effective on Lambda (function env exists before module eval). Locally, CEF bakes
# the header at import time — before .env loads — so this only takes effect if
# exported in the shell first: FRONT_END_URL=... npm run dev (spec 4.8 §9).
dev_FRONT_END_URL=http://localhost:5173
# Adds the Secure attribute to the auth cookie's Set-Cookie (login + logout).
# Keep false locally — the dev server is plain http, and a Secure cookie would
# silently never be stored. Set true in any deployed (https) environment.
dev_COOKIE_SECURE=false
